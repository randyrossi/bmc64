diff --git a/lib/usb/usbgamepad8bitdo.cpp b/lib/usb/usbgamepad8bitdo.cpp
new file mode 100644
index 00000000..7e60a948
--- /dev/null
+++ b/lib/usb/usbgamepad8bitdo.cpp
@@ -0,0 +1,106 @@
+//
+// usbgamepad8bitdo.cpp
+//
+
+#include <circle/usb/usbgamepad8bitdo.h>
+#include <circle/usb/usbhid.h>
+#include <circle/debug.h>
+#include <circle/logger.h>
+
+static const char FromUSBPad8BitDo[] = "usbpad8bitdo";
+
+#define USB_GAMEPAD_8BITDO_REPORT_SIZE 20
+
+CUSBGamePad8BitDoDevice::CUSBGamePad8BitDoDevice (CUSBFunction *pFunction)
+: CUSBGamePadXbox360Device (pFunction),
+	m_nLoggedReports (0)
+{
+}
+
+CUSBGamePad8BitDoDevice::~CUSBGamePad8BitDoDevice (void)
+{
+}
+
+boolean CUSBGamePad8BitDoDevice::Configure (void)
+{
+	CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+				  "Configuring interface %u (%u/%u/%u, %u endpoint(s))",
+				  GetInterfaceNumber (), GetInterfaceClass (), GetInterfaceSubClass (),
+				  GetInterfaceProtocol (), GetNumEndpoints ());
+
+	TUSBHIDDescriptor *pHIDDesc = (TUSBHIDDescriptor *) GetDescriptor (DESCRIPTOR_HID);
+	if (pHIDDesc != 0 && pHIDDesc->wReportDescriptorLength > 0)
+	{
+		u16 usLength = pHIDDesc->wReportDescriptorLength;
+		u8 *pDescriptor = new u8[usLength];
+		assert (pDescriptor != 0);
+
+		int nResult = GetHost ()->GetDescriptor (
+			GetEndpoint0 (), pHIDDesc->bReportDescriptorType, DESCRIPTOR_INDEX_DEFAULT,
+			pDescriptor, usLength, REQUEST_IN | REQUEST_TO_INTERFACE, GetInterfaceNumber ());
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+					  "HID report descriptor: requested %u, received %d byte(s)",
+					  usLength, nResult);
+		if (nResult > 0)
+		{
+			debug_hexdump (pDescriptor, nResult, FromUSBPad8BitDo);
+		}
+
+		delete [] pDescriptor;
+	}
+	else
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError, "No HID report descriptor");
+	}
+
+	boolean bResult = ConfigureGamePad (FALSE, USB_GAMEPAD_8BITDO_REPORT_SIZE);
+	if (!bResult)
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError, "Cannot start input request");
+	}
+
+	return bResult;
+}
+
+void CUSBGamePad8BitDoDevice::ReportHandler (const u8 *pReport, unsigned nReportSize)
+{
+	if (pReport != 0 && m_nLoggedReports++ < 32)
+	{
+		if (m_nLoggedReports == 1)
+		{
+			CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+						  "Report %u received (%u byte(s), %02X %02X)",
+						  m_nLoggedReports, nReportSize,
+						  pReport[0], nReportSize > 1 ? pReport[1] : 0);
+		}
+
+		/*CLogger::Get ()->Write (FromUSBPad8BitDo, LogNotice,
+					  "Report %u (%u byte(s))", m_nLoggedReports, nReportSize);
+		debug_hexdump (pReport, nReportSize, FromUSBPad8BitDo);*/
+	}
+
+	CUSBGamePadXbox360Device::ReportHandler (pReport, nReportSize);
+}
+
+boolean CUSBGamePad8BitDoDevice::InitializeDevice (void)
+{
+	DMA_BUFFER (u8, Command, 3) = {0x01, 0x03, 0x02};
+	if (!SendToEndpointOut (Command, sizeof Command))
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError, "Cannot initialize receiver");
+		return FALSE;
+	}
+
+	DMA_BUFFER (u8, Response, 20);
+	int nResult = GetHost ()->ControlMessage (
+		GetEndpoint0 (), REQUEST_IN | REQUEST_VENDOR | REQUEST_TO_INTERFACE,
+		1, 0x0100, GetInterfaceNumber (), Response, sizeof Response);
+	if (nResult != sizeof Response)
+	{
+		CLogger::Get ()->Write (FromUSBPad8BitDo, LogError,
+					  "Cannot read receiver state (%d byte(s))", nResult);
+		return FALSE;
+	}
+
+	return TRUE;
+}
