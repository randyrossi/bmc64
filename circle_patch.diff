 void CUSBKeyboardDevice::ReportHandler (const u8 *pReport, unsigned nReportSize)
 {
-	// Ignore report ID, if it is included.
-	if (   pReport != 0
-	    && m_nReportSize > USBKEYB_REPORT_SIZE)
+	if (pReport != 0)
 	{
-		pReport++;
-		nReportSize--;
+		CString Msg;
+
+		Msg.Format ("Report size=%u :", nReportSize);
+
+		for (unsigned i = 0; i < nReportSize; i++)
+		{
+			CString Hex;
+			Hex.Format (" %02X", pReport[i]);
+			Msg.Append (Hex);
+		}
+
+		//CLogger::Get ()->Write (FromUSBKbd, LogNotice, Msg);
 	}
 
+	u8 convertedReport[USBKEYB_REPORT_SIZE] = {0};
+
+	if (m_b8BitDoNKRO)
+	{
+		if (pReport == 0)
+		{
+			return;
+		}
+
+		/*
+		* 8BitDo NKRO report:
+		*
+		* Byte 0:     report ID 0x0C or 0x0A
+		* Byte 1:     modifier bitmap
+		* Bytes 2-16: keyboard usages 0x00-0x77 as a bitmap
+		*/
+		if (   nReportSize == 17
+			&& (pReport[0] == 0x0C || pReport[0] == 0x0A))
+		{
+			convertedReport[0] = pReport[1];	// Modifiers
+			convertedReport[1] = 0;		// Reserved
+
+			unsigned nSlots = 0;
+
+			for (unsigned nUsage = 0x04;
+				nUsage <= 0x77 && nSlots < 6;
+				nUsage++)
+			{
+				const unsigned nByteIndex = 2 + nUsage / 8;
+				const unsigned nBitMask = 1U << (nUsage % 8);
+
+				if (pReport[nByteIndex] & nBitMask)
+				{
+					u8 ucUsage = (u8) nUsage;
+
+					/*
+					* This quirk  where the keyboard sends up arrow from
+					* the numpad code when pressing the actual up arrow
+					* seems to happen only sometimes
+					* and in both wired and wireless modes.
+					*/
+					if (ucUsage == 0x60)
+					{
+						ucUsage = 0x52;
+					}
+
+					convertedReport[2 + nSlots] = ucUsage;
+					nSlots++;
+				}
+			}
+
+			pReport = convertedReport;
+			nReportSize = USBKEYB_REPORT_SIZE;
+		}
+		/*
+		* Report ID 0x01 followed by a conventional 8-byte
+		* keyboard report.
+		*/
+		else if (nReportSize == 9 && pReport[0] == 0x01)
+		{
+			pReport++;
+			nReportSize = USBKEYB_REPORT_SIZE;
+		}
+		/*
+		* Plain Boot Protocol report.
+		*/
+		else if (nReportSize == USBKEYB_REPORT_SIZE)
+		{
+			// No conversion required.
+		}
+		else
+		{
+			CLogger::Get ()->Write (
+				FromUSBKbd,
+				LogWarning,
+				"8BitDo: ignoring non-keyboard report "
+				"(id %02X, size %u)",
+				pReport[0],
+				nReportSize);
