# VICE keyboard mapping file
#
# A keyboard map is read in as a patch to the current map.
# Normal lines have 'keyname row column shiftflag'. Key names refer to
# BMC64 USB physical positions, not host characters.
# Shiftflag: 1 virtual C64 shift, 8 allow physical shift, 16 deshift,
# 32 another definition follows, 128 host Shift, 512 host AltGr.
#
# German USB keyboard, C128 symbolic mapping for BMC64.
# Characters with no C64 equivalent are marked as fallbacks below.
#
# C128 keyboard matrix (row = Bit number at left, column = Bit number above):
#
#       +-----+-----+-----+-----+-----+-----+-----+-----+
#       |Bit 0|Bit 1|Bit 2|Bit 3|Bit 4|Bit 5|Bit 6|Bit 7|
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 0| DEL |Retrn|C_L/R|  F7 |  F1 |  F3 |  F5 |C_U/D|
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 1| 3 # |  W  |  A  | 4 $ |  Z  |  S  |  E  | S_L |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 2| 5 % |  R  |  D  | 6 & |  C  |  F  |  T  |  X  |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 3| 7 ' |  Y  |  G  | 8 ( |  B  |  H  |  U  |  V  |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 4| 9 ) |  I  |  J  |  0  |  M  |  K  |  O  |  N  |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 5|  +  |  P  |  L  |  -  | . > | : [ |  @  | , < |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 6|POUND|  *  | ; ] | HOME| S_R |  =  |A_UP | / ? |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 7| 1 ! |A_LFT| CTRL| 2 " |SPACE|  C= |  Q  | R/S |
# +-----+-----+-----+-----+-----+-----+-----+-----+-----+
#
#        +-----+-----+-----+-----+-----+-----+-----+-----+
#        |Bit 0|Bit 1|Bit 2|Bit 3|Bit 4|Bit 5|Bit 6|Bit 7|
# +------+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 8 |HELP | KP 8| KP 5| TAB | KP 2| KP 4| KP 7| KP 1|
# +------+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 9 | ESC | KP +| KP -| LF  |KP CR| KP 6| KP 9| KP 3|
# +------+-----+-----+-----+-----+-----+-----+-----+-----+
# |Bit 10| ALT | KP 0| KP .|A.UP |A.DWN|A.LFT|A.RGT|NOSCR|
# +------+-----+-----+-----+-----+-----+-----+-----+-----+
#
# 'keysym -3 0' RESTORE, 'keysym -4 0' 40/80 DISPLAY,
# 'keysym -4 1' CAPS LOCK (ASCII/DIN)

!CLEAR
!LSHIFT 1 7
!RSHIFT 6 4
!VSHIFT RSHIFT
!SHIFTL LSHIFT

Escape 7 7 8             /*                   Escape -> Run/Stop                 */
1 7 0 8                  /*                      1 ! -> 1 !                      */
2 7 3 40                 /*                      2 " -> 2 "                      */
2 7 3 512                /*          AltGr+2 squared -> 2 (fallback)             */
3 1 0 40                 /*                        3 -> 3                        */
3 6 0 176                /*          Shift+3 section -> POUND (fallback)         */
3 1 0 512                /*            AltGr+3 cubed -> 3 (fallback)             */
4 1 3 8                  /*                      4 $ -> 4 $                      */
5 2 0 8                  /*                      5 % -> 5 %                      */
6 2 3 8                  /*                      6 & -> 6 &                      */
7 3 0 40                 /*                        7 -> 7                        */
7 6 7 176                /*                Shift+7 / -> /                        */
7 5 5 513                /*                AltGr+7 { -> [                        */
8 3 3 40                 /*                      8 ( -> 8 (                      */
8 5 5 513                /*                AltGr+8 [ -> [                        */
9 4 0 40                 /*                      9 ) -> 9 )                      */
9 6 2 513                /*                AltGr+9 ] -> ]                        */
0 4 3 40                 /*                        0 -> 0                        */
0 6 5 176                /*                Shift+0 = -> =                        */
0 6 2 513                /*                AltGr+0 } -> ]                        */
Dash 6 0 40              /*                  sharp s -> POUND (fallback)         */
Dash 6 7 161             /*          Shift+sharp s ? -> ?                        */
Dash 6 0 512             /*  AltGr+sharp s backslash -> POUND (fallback)         */
Equals 7 1 40            /*                    acute -> Left Arrow (fallback)    */
Equals 7 1 144           /*        Shift+acute grave -> Left Arrow               */
Pound 1 0 33             /*                        # -> #                        */
Pound 3 0 129            /*       Shift+# apostrophe -> '                        */
BackSpace 0 0 8          /*                Backspace -> DEL                      */
Control_L 7 5 8          /*             Left Control -> CBM                      */
q 7 6 40                 /*                        Q -> Q                        */
q 5 6 512                /*                AltGr+Q @ -> @                        */
w 1 1 8                  /*                        W -> W                        */
e 1 6 40                 /*                        E -> E                        */
e 6 0 512                /*             AltGr+E euro -> POUND (fallback)         */
r 2 1 8                  /*                        R -> R                        */
t 2 6 8                  /*                        T -> T                        */
y 1 4 8                  /*                        Z -> Z                        */
u 3 6 8                  /*                        U -> U                        */
i 4 1 8                  /*                        I -> I                        */
o 4 6 8                  /*                        O -> O                        */
p 5 1 8                  /*                        P -> P                        */
LeftBracket 5 6 8        /*                 u umlaut -> @ (fallback)             */
RightBracket 5 0 40      /*                        + -> +                        */
RightBracket 6 1 176     /*                Shift++ * -> *                        */
RightBracket 5 0 513     /*                  AltGr++ -> Shift++                  */
Return 0 1 8             /*                   Return -> Return                   */
Tab 7 2 8                /*                      Tab -> CTRL                     */
a 1 2 8                  /*                        A -> A                        */
s 1 5 8                  /*                        S -> S                        */
d 2 2 8                  /*                        D -> D                        */
f 2 5 8                  /*                        F -> F                        */
g 3 2 8                  /*                        G -> G                        */
h 3 5 8                  /*                        H -> H                        */
j 4 2 8                  /*                        J -> J                        */
k 4 5 8                  /*                        K -> K                        */
l 5 2 8                  /*                        L -> L                        */
SemiColon 5 5 8          /*                 o umlaut -> : [ (fallback)           */
SingleQuote 6 2 8        /*                 a umlaut -> ; ] (fallback)           */
BackQuote 6 6 40         /*                        ^ -> Up Arrow                 */
BackQuote 6 0 144        /*           Shift+^ degree -> POUND (fallback)         */
BackSlash 1 0 33         /*                        # -> #                        */
BackSlash 3 0 129        /*       Shift+# apostrophe -> '                        */
Shift_L 1 7 2            /*               Left Shift -> Left Shift               */
CapsLock 1 7 64          /*                Caps Lock -> Shift Lock               */
NonUSBackSlash 5 7 33    /*                        < -> <                        */
NonUSBackSlash 5 4 161   /*                Shift+< > -> >                        */
NonUSBackSlash 5 3 513   /*                AltGr+< | -> Shift+-                  */
z 3 1 8                  /*                        Y -> Y                        */
x 2 7 8                  /*                        X -> X                        */
c 2 4 8                  /*                        C -> C                        */
v 3 7 8                  /*                        V -> V                        */
b 3 4 8                  /*                        B -> B                        */
n 4 7 8                  /*                        N -> N                        */
m 4 4 40                 /*                        M -> M                        */
m 6 6 513                /*               AltGr+M mu -> Pi (fallback)            */
Comma 5 7 40             /*                        , -> ,                        */
Comma 6 2 144            /*                Shift+, ; -> ;                        */
Period 5 4 40            /*                        . -> .                        */
Period 5 5 144           /*                Shift+. : -> :                        */
Slash 5 3 40             /*                        - -> -                        */
Slash 5 3 129            /*                Shift+- _ -> Shift+-                  */
Shift_R 6 4 4            /*              Right Shift -> Right Shift              */
Space 7 4 8              /*                    Space -> Space                    */
F1 0 4 8                 /*                       F1 -> F1                       */
F2 0 4 1                 /*                       F2 -> F2                       */
F3 0 5 8                 /*                       F3 -> F3                       */
F4 0 5 1                 /*                       F4 -> F4                       */
F5 0 6 8                 /*                       F5 -> F5                       */
F6 0 6 1                 /*                       F6 -> F6                       */
F7 0 3 8                 /*                       F7 -> F7                       */
F8 0 3 1                 /*                       F8 -> F8                       */
Home 6 3 8               /*                     Home -> CLR/HOME                 */
Up 0 7 1                 /*                       Up -> CRSR UP                  */
Down 0 7 8               /*                     Down -> CRSR DOWN                */
Insert 0 0 1             /*                   Insert -> INS                      */
Del 0 0 8                /*                   Delete -> DEL                      */
Left 0 2 1               /*                     Left -> CRSR LEFT                */
Right 0 2 8              /*                    Right -> CRSR RIGHT               */
KP_Divide 6 7 8          /*                 NumPad / -> /                        */
KP_Multiply 6 1 8        /*                 NumPad * -> *                        */
KP_0 10 1 8              /*                 NumPad 0 -> KP 0                     */
KP_1 8 7 8               /*                 NumPad 1 -> KP 1                     */
KP_2 8 4 8               /*                 NumPad 2 -> KP 2                     */
KP_3 9 7 8               /*                 NumPad 3 -> KP 3                     */
KP_4 8 5 8               /*                 NumPad 4 -> KP 4                     */
KP_5 8 2 8               /*                 NumPad 5 -> KP 5                     */
KP_6 9 5 8               /*                 NumPad 6 -> KP 6                     */
KP_7 8 6 8               /*                 NumPad 7 -> KP 7                     */
KP_8 8 1 8               /*                 NumPad 8 -> KP 8                     */
KP_9 9 6 8               /*                 NumPad 9 -> KP 9                     */
KP_Decimal 10 2 8        /*                 NumPad , -> KP .                     */
KP_Add 9 1 8             /*                 NumPad + -> KP +                     */
KP_Subtract 9 2 8        /*                 NumPad - -> KP -                     */
KP_Enter 9 4 8           /*             NumPad Enter -> KP ENTER                 */

PageUp -3 0              /*                  Page Up -> RESTORE                  */

# C128 extra keys
F9 9 0 8                 /*                       F9 -> ESC                      */
F10 8 3 8                /*                      F10 -> TAB                      */
F11 -4 0                 /*                      F11 -> 40/80 DISPLAY            */
End 8 0 8                /*                      End -> HELP                     */
PageDown 9 3 8           /*                Page Down -> LINE FEED                */
ScrollLock 10 7 8        /*              Scroll Lock -> NO SCROLL                */
Pause -4 1               /*                    Pause -> CAPS LOCK (ASCII/DIN)    */
Alt_L 10 0 8             /*                 Left Alt -> ALT                      */
