#!/bin/sh
# Build the Pico mock HID firmware, run the native tests, and refresh
# bin/mock_hid.uf2 with its checksum, size and tool versions in bin/README.md.
#
# Pico SDK: $PICO_SDK_PATH, else the path saved in an existing build/.
# Arm GCC:  the compiler saved in an existing build/, else $PICO_TOOLCHAIN_PATH,
#           else arm-none-eabi-gcc on PATH.
# Usage:    ./build_uf2 [--clean]   (--clean reconfigures build/ from scratch)
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUILD="$HERE/build"
CACHE="$BUILD/CMakeCache.txt"

fail() {
    echo "build_uf2: $*" >&2
    exit 1
}

cached() {
    [ -f "$CACHE" ] && sed -n "s/^$1:[A-Z]*=//p" "$CACHE" || true
}

[ $# -eq 0 ] || [ "$1" = "--clean" ] || fail "usage: $0 [--clean]"
SAVED_SDK=$(cached PICO_SDK_PATH)
SAVED_GCC=$(cached CMAKE_C_COMPILER)
SAVED_SOURCE=$(cached CMAKE_HOME_DIRECTORY)
if [ "${1:-}" = "--clean" ]; then
    rm -rf "$BUILD"
elif [ -n "$SAVED_SOURCE" ] && [ "$SAVED_SOURCE" != "$HERE" ]; then
    # A build/ copied from another checkout cannot be reused by CMake.
    echo "build/ was configured for $SAVED_SOURCE; reconfiguring it here"
    rm -rf "$BUILD"
fi

SDK=${PICO_SDK_PATH:-$SAVED_SDK}
[ -n "$SDK" ] || fail "set PICO_SDK_PATH to your Pico SDK checkout"
[ -f "$SDK/external/pico_sdk_import.cmake" ] || fail "no Pico SDK at $SDK"
[ -f "$SDK/lib/tinyusb/src/tusb.h" ] ||
    fail "TinyUSB missing; run: git -C $SDK submodule update --init lib/tinyusb"
export PICO_SDK_PATH="$SDK"

# An existing build/ keeps its configured compiler; use --clean to change it.
if [ -f "$CACHE" ] && [ -n "$SAVED_GCC" ]; then
    GCC=$SAVED_GCC
elif [ -n "${PICO_TOOLCHAIN_PATH:-}" ]; then
    GCC="$PICO_TOOLCHAIN_PATH/bin/arm-none-eabi-gcc"
elif command -v arm-none-eabi-gcc >/dev/null 2>&1; then
    GCC=$(command -v arm-none-eabi-gcc)
else
    GCC=$SAVED_GCC
fi
[ -n "$GCC" ] && [ -x "$GCC" ] ||
    fail "Arm GCC not found; set PICO_TOOLCHAIN_PATH to its install directory"
export PICO_TOOLCHAIN_PATH=$(dirname -- "$(dirname -- "$GCC")")

echo "Pico SDK: $SDK"
echo "Arm GCC:  $GCC"

if [ ! -f "$CACHE" ]; then
    echo "Configuring build/"
    cmake -S "$HERE" -B "$BUILD" -DPICO_BOARD=pico -DCMAKE_BUILD_TYPE=Release
fi
echo "Building firmware"
cmake --build "$BUILD" --parallel "$(nproc 2>/dev/null || echo 2)"
[ -f "$BUILD/mock_hid.uf2" ] || fail "build did not produce build/mock_hid.uf2"

echo "Running native protocol and client tests"
make -C "$HERE" test all

cp "$BUILD/mock_hid.uf2" "$HERE/bin/mock_hid.uf2"
SHA=$(sha256sum "$HERE/bin/mock_hid.uf2" | cut -d' ' -f1)
SIZE=$(wc -c < "$HERE/bin/mock_hid.uf2" | tr -d ' ')
SIZE_TEXT=$(printf "%s" "$SIZE" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')
SDK_VERSION=$(sed -n 's/.*set(PICO_SDK_VERSION_\(MAJOR\|MINOR\|REVISION\) \([0-9]*\)).*/\2/p' \
    "$SDK/pico_sdk_version.cmake" | paste -sd.)
GCC_VERSION=$("$GCC" -dumpversion)
CMAKE_VERSION=$(cmake --version | sed -n '1s/.* //p')

README="$HERE/bin/README.md"
sed -i \
    -e "s/^| Pico SDK | .* |$/| Pico SDK | $SDK_VERSION |/" \
    -e "s/^| Arm GCC | .* |$/| Arm GCC | $GCC_VERSION |/" \
    -e "s/^| CMake | .* |$/| CMake | $CMAKE_VERSION |/" \
    -e "s/^| UF2 size | .* |$/| UF2 size | $SIZE_TEXT bytes |/" \
    -e "s/^[0-9a-f]\{64\}$/$SHA/" \
    "$README"

echo
echo "Updated bin/mock_hid.uf2 ($SIZE_TEXT bytes)"
echo "SHA-256: $SHA"
echo "bin/README.md updated: SDK $SDK_VERSION, GCC $GCC_VERSION, CMake $CMAKE_VERSION."
echo "Check its picotool version and validation notes by hand."
echo "Flash: hold BOOTSEL, plug the Pico into this PC, copy bin/mock_hid.uf2 to RPI-RP2."
